#!/usr/bin/env bash
# gsign / gverify — detached signatures for files you publish or receive.
# Called as gsign:   gsign FILE...        -> FILE.asc
# Called as gverify: gverify FILE         -> checks FILE.asc against FILE
set -euo pipefail

MODE=$(basename "$0")

case $MODE in
gsign)
    [[ $# -gt 0 ]] || { echo "usage: gsign FILE..." >&2; exit 1; }
    for f in "$@"; do
        [[ -f $f ]] || { echo "gsign: no such file: $f" >&2; exit 1; }
        gpg --armor --detach-sign --output "$f.asc" --yes "$f"
        echo "signed -> $f.asc"
    done
    ;;
gverify)
    [[ $# -gt 0 ]] || { echo "usage: gverify FILE [SIGFILE]" >&2; exit 1; }
    f=$1
    sig=${2:-}
    if [[ -z $sig ]]; then
        for cand in "$f.asc" "$f.sig" "${f%.*}.asc"; do
            [[ -f $cand ]] && { sig=$cand; break; }
        done
    fi
    [[ -n $sig ]] || { echo "gverify: no signature file found for $f" >&2; exit 1; }
    gpg --verify "$sig" "$f"
    ;;
*)
    echo "gsign: link me as gsign or gverify" >&2
    exit 1
    ;;
esac
