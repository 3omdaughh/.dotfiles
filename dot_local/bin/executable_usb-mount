#!/usr/bin/env bash
# usb-mount — auto mount/unmount external drives via wmenu + mako notifications
#
# Usage:
#   usb-mount daemon     # watch udev for plugged-in drives (autostarted from startwl.sh)
#   usb-mount            # menu: pick a connected drive → open terminal there or unmount
#   usb-mount unmount    # menu: pick a mounted drive to unmount
#
# Each device gets its own mount point: /mnt/external/<label or devname>,
# so several drives can be mounted at the same time.
# Privilege escalation via doas (passwordless per /etc/doas.conf).

set -u

MOUNT_BASE="/mnt/external"
TERMINAL="foot"

notify() { notify-send -a usb-mount "$@"; }

menu() { wmenu -f "JetBrainsMono Nerd Font 10" "$@"; }

# Where a device is currently mounted (empty if not mounted).
mounted_at() { findmnt -no TARGET "$1" | head -n1; }

# Pick a mount point for a device: label if available, else device name.
mount_point_for() {
    dev="$1"
    label=$(lsblk -no LABEL "$dev" | head -n1 | tr ' /' '__')
    mp="$MOUNT_BASE/${label:-$(basename "$dev")}"
    # Label collision with an already-mounted drive: fall back to device name.
    if mountpoint -q "$mp"; then
        mp="$MOUNT_BASE/$(basename "$dev")"
    fi
    printf '%s' "$mp"
}

do_mount() {
    dev="$1"
    fstype=$(lsblk -no FSTYPE "$dev" | head -n1)
    label=$(lsblk -no LABEL "$dev" | head -n1)

    mp=$(mounted_at "$dev")
    if [ -n "$mp" ]; then
        notify "usb-mount" "${label:-$dev} already mounted at $mp"
        return 0
    fi

    mp=$(mount_point_for "$dev")
    doas mkdir -p "$mp" || {
        notify -u critical "Mount failed" "doas denied — check /etc/doas.conf"
        return 1
    }

    case "$fstype" in
        ntfs*)
            doas ntfs-3g "$dev" "$mp"
            ;;
        "")
            notify -u critical "Mount failed" "no filesystem detected on $dev"
            doas rmdir "$mp" 2>/dev/null
            return 1
            ;;
        *)
            doas mount "$dev" "$mp"
            ;;
    esac

    if mountpoint -q "$mp"; then
        notify "Mounted" "${label:-$dev} ($fstype) → $mp"
    else
        notify -u critical "Mount failed" "$dev could not be mounted"
        doas rmdir "$mp" 2>/dev/null
        return 1
    fi
}

# Unmount a specific device and clean up its mount point directory.
unmount_device() {
    dev="$1"
    mp=$(mounted_at "$dev")
    if [ -z "$mp" ]; then
        notify "usb-mount" "$dev is not mounted — nothing to do"
        return 0
    fi
    if doas umount "$mp"; then
        case "$mp" in "$MOUNT_BASE"/*) doas rmdir "$mp" 2>/dev/null ;; esac
        notify "Unmounted" "$dev from $mp — safe to unplug"
    else
        notify -u critical "Unmount failed" "$mp busy — close files/terminals using it"
        return 1
    fi
}

# Notify about a newly plugged partition and ask via wmenu whether to mount it.
ask_mount() {
    dev="$1"
    fstype=$(lsblk -no FSTYPE "$dev" | head -n1)
    label=$(lsblk -no LABEL "$dev" | head -n1)
    size=$(lsblk -no SIZE "$dev" | head -n1)

    notify "Drive plugged in" "${label:-$dev} $size (${fstype:-unknown fs})"

    choice=$(printf 'mount\nignore\n' | menu -p "${label:-$dev} $size — mount?")
    [ "$choice" = "mount" ] && do_mount "$dev"
}

# Lazy-unmount any mount under MOUNT_BASE whose source device vanished.
cleanup_yanked() {
    findmnt -rno TARGET,SOURCE | while read -r target src; do
        case "$target" in "$MOUNT_BASE"/*) ;; *) continue ;; esac
        if [ ! -e "$src" ]; then
            doas umount -l "$target"
            doas rmdir "$target" 2>/dev/null
            notify -u critical "Drive removed while mounted" \
                "$src unplugged without unmounting — data may be lost. Unmount before pulling the drive next time."
        fi
    done
}

daemon() {
    udevadm monitor --udev --subsystem-match=block | while read -r _ _ action devpath _; do
        case "$action" in
            add)
                props=$(udevadm info -q property -p "$devpath" 2>/dev/null) || continue
                printf '%s\n' "$props" | grep -qx 'DEVTYPE=partition' || continue
                printf '%s\n' "$props" | grep -qx 'ID_BUS=usb' || continue
                dev=$(printf '%s\n' "$props" | sed -n 's/^DEVNAME=//p')
                [ -n "$dev" ] && ask_mount "$dev" &
                ;;
            remove)
                cleanup_yanked
                ;;
        esac
    done
}

# List connected hotplug (USB) partitions as "device size fstype label state" lines.
list_usb_partitions() {
    lsblk -Ppno NAME,SIZE,FSTYPE,LABEL,TYPE,HOTPLUG,MOUNTPOINT | while IFS= read -r line; do
        eval "$line"
        if [ "$TYPE" = "part" ] && [ "$HOTPLUG" = "1" ]; then
            printf '%s %s %s %s %s\n' \
                "$NAME" "$SIZE" "${FSTYPE:--}" "${LABEL:--}" "${MOUNTPOINT:-[not mounted]}"
        fi
    done
}

# Open a terminal at the device's mount point, mounting it first if needed.
open_terminal() {
    dev="$1"
    mp=$(mounted_at "$dev")
    if [ -z "$mp" ]; then
        do_mount "$dev" || return 1
        mp=$(mounted_at "$dev")
        [ -z "$mp" ] && return 1
    fi
    "$TERMINAL" -D "$mp" >/dev/null 2>&1 &
    notify "Terminal opened" "$dev at $mp"
}

# Hotkey entry point: pick a connected device, then choose what to do with it.
device_menu() {
    candidates=$(list_usb_partitions)
    if [ -z "$candidates" ]; then
        notify "usb-mount" "no USB partitions connected"
        return 0
    fi

    chosen=$(printf '%s\n' "$candidates" | menu -l 5 -p "USB devices:")
    [ -z "$chosen" ] && return 0
    dev=${chosen%% *}

    action=$(printf 'open terminal\nunmount\n' | menu -p "$dev:")
    case "$action" in
        "open terminal") open_terminal "$dev" ;;
        unmount)         unmount_device "$dev" ;;
    esac
}

# Pick one of the currently mounted USB drives to unmount.
unmount_menu() {
    mounted=$(list_usb_partitions | grep -v '\[not mounted\]$')
    if [ -z "$mounted" ]; then
        notify "usb-mount" "no mounted USB drives"
        return 0
    fi
    chosen=$(printf '%s\n' "$mounted" | menu -l 5 -p "unmount which drive?")
    [ -n "$chosen" ] && unmount_device "${chosen%% *}"
}

case "${1:-menu}" in
    daemon)  daemon ;;
    unmount) unmount_menu ;;
    mount)   device_menu ;;
    menu)    device_menu ;;
    *)       echo "usage: usb-mount [daemon|unmount|menu]" >&2; exit 1 ;;
esac
