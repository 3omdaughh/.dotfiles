#!/usr/bin/env bash
#
# wifi-menu — Wi-Fi connection menu for wmenu + NetworkManager (nmcli).
#
# Behavior:
#   * Ensures the Wi-Fi radio is enabled (enables it if off).
#   * Shows available networks in wmenu, refreshing the list every
#     REFRESH_SECS seconds (wmenu cannot reload stdin while open, so the
#     menu is relaunched with fresh scan results; the script keeps running).
#   * Open networks connect immediately; secured networks prompt for a
#     password via wmenu -P (masked input).
#   * On any failure the user is notified via mako (notify-send) and
#     returned to the password prompt / network list. The script only
#     exits on success or when the user presses Escape in the network list.
#
# Note: killing wmenu on refresh discards any filter text typed in the
# menu; this is the price of live-refreshing lists with wmenu.

set -u

REFRESH_SECS=5
APP_NAME="wifi-menu"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/wifi-menu.lock"
WMENU_LINES=15
WMENU_FONT="JetBrainsMono Nerd Font 10"

notify() { # notify <urgency> <title> <body>
    notify-send -a "$APP_NAME" -u "$1" "$2" "$3"
}

die() {
    notify critical "Wi-Fi menu" "$1"
    exit 1
}

menu() { # menu <prompt> [extra wmenu args...] — reads stdin, prints choice
    local prompt=$1
    shift
    wmenu -i -f "$WMENU_FONT" -l "$WMENU_LINES" -p "$prompt" "$@"
}

require_tools() {
    local tool
    for tool in nmcli wmenu notify-send; do
        command -v "$tool" >/dev/null 2>&1 || die "Missing required tool: $tool"
    done
}

single_instance() {
    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
        notify normal "Wi-Fi menu" "Already running."
        exit 0
    fi
}

ensure_radio_on() {
    if [[ "$(nmcli radio wifi)" != "enabled" ]]; then
        if nmcli radio wifi on; then
            notify normal "Wi-Fi" "Radio was off — enabled it."
            # Give the interface a moment to come up before the first scan.
            sleep 2
        else
            die "Failed to enable Wi-Fi radio."
        fi
    fi
}

# Trigger a background rescan. nmcli rejects rescans requested too
# frequently; that is harmless, so errors are ignored. Results are picked
# up by the next `nmcli dev wifi list` call.
request_rescan() {
    nmcli device wifi rescan >/dev/null 2>&1 || true
}

# Populate NETWORKS (display line -> "ssid<US>security") and MENU_LINES.
# Uses nmcli terse output with escaping enabled; escaped "\:" in SSIDs is
# protected with a control char before splitting so SSIDs containing ":"
# parse correctly.
declare -A NETWORKS=()
MENU_LINES=""
build_network_list() {
    NETWORKS=()
    MENU_LINES=""
    local raw line in_use ssid security signal display lock
    local -A seen=()
    local active_ssid=""
    raw=$(nmcli -t -e yes -f IN-USE,SSID,SECURITY,SIGNAL device wifi list --rescan no 2>/dev/null) || return

    # First pass: find the SSID of the currently active access point so
    # the "(connected)" marker survives per-SSID deduplication even when
    # the active BSSID is not the strongest one.
    while IFS= read -r line; do
        [[ "$line" == \** ]] || continue
        line=${line//\\:/$'\x01'}
        IFS=: read -r in_use ssid security signal <<<"$line"
        active_ssid=${ssid//$'\x01'/:}
        break
    done <<<"$raw"

    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        line=${line//\\:/$'\x01'}                # protect escaped colons
        IFS=: read -r in_use ssid security signal <<<"$line"
        ssid=${ssid//$'\x01'/:}
        [[ -n "$ssid" ]] || continue             # skip hidden networks

        # Keep the strongest entry per SSID (list is sorted by signal).
        [[ -v seen["$ssid"] ]] && continue
        seen["$ssid"]=1

        lock=""
        [[ -n "$security" && "$security" != "--" ]] && lock=" [locked]"
        display=$(printf '%-32s %3s%%%s%s' "$ssid" "$signal" "$lock" \
            "$([[ "$ssid" == "$active_ssid" ]] && echo '  (connected)')")
        NETWORKS["$display"]="${ssid}"$'\x1f'"${security}"
        MENU_LINES+="$display"$'\n'
    done <<<"$raw"
}

# Show the network list, refreshing every REFRESH_SECS by relaunching
# wmenu. Sets SELECTED_SSID / SELECTED_SECURITY on selection.
# Returns 0 on selection, 1 if the user cancelled (Escape).
SELECTED_SSID=""
SELECTED_SECURITY=""
select_network() {
    local choice rc
    while true; do
        request_rescan
        build_network_list

        if [[ -z "$MENU_LINES" ]]; then
            # Nothing found yet; wait for scan results rather than
            # showing an empty menu.
            sleep "$REFRESH_SECS"
            continue
        fi

        choice=$(printf '%s' "$MENU_LINES" \
            | timeout --foreground "$REFRESH_SECS" \
                wmenu -i -f "$WMENU_FONT" -l "$WMENU_LINES" -p "Wi-Fi:")
        rc=$?

        if [[ $rc -eq 124 ]]; then
            continue                              # timeout -> refresh list
        elif [[ $rc -ne 0 || -z "$choice" ]]; then
            return 1                              # user cancelled
        fi

        if [[ -v NETWORKS["$choice"] ]]; then
            SELECTED_SSID=${NETWORKS["$choice"]%%$'\x1f'*}
            SELECTED_SECURITY=${NETWORKS["$choice"]#*$'\x1f'}
            return 0
        fi
        # Free-typed text that matches no entry: ignore and re-show.
    done
}

# Prompt for a password with masked input. Returns 1 on cancel.
prompt_password() { # prompt_password <ssid>
    PASSWORD=$(menu "Password for $1:" -P </dev/null)
    [[ $? -eq 0 && -n "$PASSWORD" ]]
}

# Remove a connection profile left behind by a failed attempt so stale
# credentials don't shadow the next try.
delete_profile() { # delete_profile <name>
    nmcli connection delete id "$1" >/dev/null 2>&1 || true
}

profile_exists() { # profile_exists <name>
    nmcli -t -g NAME connection show 2>/dev/null | grep -Fxq "$1"
}

# Attempt to connect to SELECTED_SSID. Returns 0 on success.
connect_selected() {
    local ssid=$SELECTED_SSID security=$SELECTED_SECURITY out

    # A saved profile may already hold valid credentials.
    if profile_exists "$ssid"; then
        notify normal "Wi-Fi" "Connecting to \"$ssid\" (saved profile)…"
        if out=$(nmcli connection up id "$ssid" 2>&1); then
            notify normal "Wi-Fi connected" "Connected to \"$ssid\"."
            return 0
        fi
        # Saved credentials failed (changed password, etc.) — drop the
        # profile and fall through to a fresh attempt.
        notify normal "Wi-Fi" "Saved profile for \"$ssid\" failed; retrying fresh."
        delete_profile "$ssid"
    fi

    if [[ -z "$security" || "$security" == "--" ]]; then
        notify normal "Wi-Fi" "Connecting to open network \"$ssid\"…"
        if out=$(nmcli device wifi connect "$ssid" 2>&1); then
            notify normal "Wi-Fi connected" "Connected to \"$ssid\"."
            return 0
        fi
        delete_profile "$ssid"
        notify critical "Wi-Fi failed" "Could not connect to \"$ssid\":\n${out}"
        return 1
    fi

    # Secured network: keep prompting until success or the user escapes
    # back to the network list.
    local PASSWORD
    while true; do
        if ! prompt_password "$ssid"; then
            return 1                              # back to network list
        fi
        notify normal "Wi-Fi" "Connecting to \"$ssid\"…"
        if out=$(nmcli device wifi connect "$ssid" password "$PASSWORD" 2>&1); then
            notify normal "Wi-Fi connected" "Connected to \"$ssid\"."
            return 0
        fi
        delete_profile "$ssid"
        notify critical "Wi-Fi failed" \
            "Connection to \"$ssid\" failed (wrong password?):\n${out}"
    done
}

main() {
    require_tools
    single_instance
    ensure_radio_on

    while true; do
        if ! select_network; then
            exit 0                                # user quit from the list
        fi
        if connect_selected; then
            exit 0                                # success — close gracefully
        fi
        # Connection failed or password prompt cancelled: back to the list.
    done
}

main "$@"
