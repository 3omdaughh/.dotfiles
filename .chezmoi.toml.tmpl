{{- $hostname := promptStringOnce . "hostname" "Machine hostname" -}}
{{- $machine := promptChoiceOnce . "machine" "Machine class" (list "laptop" "desktop") -}}
{{- $gpu := promptChoiceOnce . "gpu" "GPU vendor" (list "intel" "amd" "nvidia") -}}
{{- $email := promptStringOnce . "email" "Git email" -}}

[data]
    hostname = {{ $hostname | quote }}
    machine  = {{ $machine | quote }}
    gpu      = {{ $gpu | quote }}
    email    = {{ $email | quote }}
